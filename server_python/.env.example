# ST★R Tours - Backend Environment Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Secret key used to sign JWT tokens (change to a long random string!)
JWT_SECRET=change-me-to-a-long-random-secret-string

# Port the Flask API runs on
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/startours
# Atlas: mongodb+srv://<user>:<password>@<cluster>/startours
MONGODB_URI=mongodb://localhost:27017/startours

# Admin account (auto-created on first start)
ADMIN_EMAIL=admin@startours.com
ADMIN_PASSWORD=admin123
